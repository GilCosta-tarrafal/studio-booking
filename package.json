{
  "name": "studio-booking",
  "version": "1.0.0",
  "description": "Site de marcações e painel de gestão para produtor com vários estúdios",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "api",
    "site",
    "admin"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env dev.js",
    "dev:start": "node --env-file-if-exists=.env dev.js --parte=api --vigiar --pagamentos-demo",
    "dev:site": "node --env-file-if-exists=.env dev.js --parte=site --vigiar",
    "dev": "node --env-file-if-exists=.env dev.js --parte=painel --vigiar",
    "comum": "node scripts/copiar-comum.js",
    "pretest": "node scripts/copiar-comum.js",
    "test": "node test/api.test.js && node test/integracoes.test.js",
    "test:integracoes": "node scripts/copiar-comum.js && node test/integracoes.test.js",
    "test:frontend": "node scripts/copiar-comum.js && node test/frontend.test.js",
    "backup": "node api/scripts/backup.js",
    "testar-email": "node --env-file-if-exists=.env api/scripts/testar-email.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
