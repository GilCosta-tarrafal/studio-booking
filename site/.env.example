# Site público. Copie para .env (nesta pasta) ou defina no painel do alojamento.
# No computador não é preciso: o `npm run dev` na raiz arranca tudo.

# Onde está a API (a pasta api/). O site reencaminha-lhe /api.
API_URL=https://api.o-seu-dominio

# Porta (a maioria dos alojamentos define-a sozinha). Por omissão 3005.
# PORT=3005

# Atrás do proxy do alojamento, para ler o protocolo (https) certo.
TRUST_PROXY=1
