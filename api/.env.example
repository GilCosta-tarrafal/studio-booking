# API. Em serviços de alojamento, defina estas variáveis no painel do serviço.
# Em produção, copie para api/.env. No computador, copie para .env na RAIZ do
# projeto: os `npm run dev`, `dev:site` e `dev:start` leem-no.

# Conta do proprietário, criada só na primeira vez que o servidor arranca.
# Se não definir a palavra-passe, é gerada uma e mostrada no registo (log) do arranque.
ADMIN_EMAIL=dono@exemplo.com
ADMIN_PASSWORD=escolha-uma-palavra-passe-longa

# Fuso horário do estúdio (afeta "hoje", horas passadas e antecedência mínima).
TIMEZONE=Atlantic/Cape_Verde

# Onde guardar a base de dados. Em produção, aponte para um disco persistente.
DATA_DIR=./data

# Em produção (HTTPS): cookies só por HTTPS.
COOKIE_SECURE=1

# Onde estão o site e o painel, para os links dos emails, o "Ver o site" do
# painel e o regresso do Stripe. Em produção, defina sempre os dois.
# SITE_URL=https://o-seu-dominio
# PAINEL_URL=https://painel.o-seu-dominio

# IP real de quem visita (para os limites de pedidos). Os pedidos chegam pelo
# site e pelo painel; por omissão confia-se no IP que eles indicam quando vêm de
# uma rede interna. Ponha o site e o painel a falar com a API pela rede privada
# do alojamento (ou na mesma máquina) e não precisa de mexer nisto. Só se
# passarem pela internet: TRUST_PROXY = número de proxies pelo meio (ex.: 3).
# TRUST_PROXY=3

# PORT=3007   (a maioria dos alojamentos define-a sozinha)
# No computador, as portas das três partes: SITE_PORT=3005, ADMIN_PORT=3006, API_PORT=3007.
# SEED_DEMO=0   # não criar os estúdios de exemplo na primeira execução

# Procura de coordenadas dos estúdios (campo "Onde fica", no painel).
# Por omissão usa o OpenStreetMap, que é gratuito e não pede chave.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GEOCODER=off      # desliga a procura; colar o link do Google Maps continua a funcionar

# ---- Contas de cliente: envio do código de recuperação de palavra-passe.
# Sem nenhum destes, o código não falha: aparece no registo (log) do servidor,
# para se poder testar. Em produção, ligue pelo menos um canal.
# Email (escolha um): Gmail/SMTP, Resend ou Brevo. Teste com: npm run testar-email -- voce@exemplo.com
# Gmail: SMTP_USER = o endereço Gmail; SMTP_PASS = palavra-passe de APLICAÇÃO
# (https://myaccount.google.com/apppasswords), não a normal. Outro servidor SMTP:
# defina também SMTP_HOST e SMTP_PORT (por omissão smtp.gmail.com, 465).
# SMTP_USER=o-seu-endereco@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM é o remetente mostrado (sem ele: o nome do negócio + SMTP_USER).
# MAIL_FROM=Estúdio <nao-responder@o-seu-dominio>
# RESEND_API_KEY=re_...
# BREVO_API_KEY=xkeysib-...
# SMS (Twilio). O número é enviado em formato +indicativo (usa country_code das Definições).
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_SMS_FROM=+...

# ---- Integrações (ver integracoes/README.md). Sem estas variáveis, ficam desligadas.
# O Stripe devolve o cliente ao SITE_URL (acima) depois de pagar.

# Pagamentos online (Stripe).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=eur     # só se a moeda das Definições não for um código ISO

# Plataforma da gravadora: lançamentos e reproduções.
# GRAVADORA_WEBHOOK_SECRET=um-texto-longo-e-aleatorio
# GRAVADORA_FEED_URL=https://plataforma.exemplo/api/lancamentos
# GRAVADORA_TOKEN=...
# GRAVADORA_INTERVALO_MIN=60

# Assistente IA do painel (botão de auriculares). Chave em https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-...

# Taxas de câmbio: ligadas por omissão (gratuitas, sem chave), atualizadas 1x/dia.
# CAMBIO=off
