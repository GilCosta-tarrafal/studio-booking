# Copie para .env e ajuste. Em serviços de alojamento, defina estas variáveis no painel do serviço.

# Conta do proprietário, criada só na primeira vez que o servidor arranca.
# Se não definir a palavra-passe, é gerada uma e mostrada no registo (log) do arranque.
ADMIN_EMAIL=dono@exemplo.com
ADMIN_PASSWORD=escolha-uma-palavra-passe-longa

# Fuso horário do estúdio (afeta "hoje", horas passadas e antecedência mínima).
TIMEZONE=Atlantic/Cape_Verde

# Onde guardar a base de dados. Em produção, aponte para um disco persistente.
DATA_DIR=./backend/data

# Em produção (HTTPS): cookies só por HTTPS e IP real atrás do proxy do serviço.
COOKIE_SECURE=1
TRUST_PROXY=1

# PORT=3005   (sem PORT, usa a 3005 e salta para a seguinte se estiver ocupada)
# SEED_DEMO=0   # não criar os estúdios de exemplo na primeira execução

# Procura de coordenadas dos estúdios (campo "Onde fica", no painel).
# Por omissão usa o OpenStreetMap, que é gratuito e não pede chave.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GEOCODER=off      # desliga a procura; colar o link do Google Maps continua a funcionar

# ---- Integrações (ver integracoes/README.md). Sem estas variáveis, ficam desligadas.
# Endereço público do site, para o Stripe devolver o cliente depois de pagar.
# SITE_URL=https://o-seu-dominio

# Pagamentos online (Stripe).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=eur     # só se a moeda das Definições não for um código ISO

# Plataforma da gravadora: lançamentos e reproduções.
# GRAVADORA_WEBHOOK_SECRET=um-texto-longo-e-aleatorio
# GRAVADORA_FEED_URL=https://plataforma.exemplo/api/lancamentos
# GRAVADORA_TOKEN=...
# GRAVADORA_INTERVALO_MIN=60
