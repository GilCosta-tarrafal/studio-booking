# Painel de gestão. Copie para .env (nesta pasta) ou defina no painel do alojamento.
# No computador não é preciso: o `npm run dev` na raiz arranca tudo.

# Onde está a API (a pasta api/). O painel reencaminha-lhe /api.
API_URL=https://api.o-seu-dominio

# Endereço público do site, para onde vai quem abrir aqui uma página do site.
SITE_URL=https://o-seu-dominio

# Porta (a maioria dos alojamentos define-a sozinha). Por omissão 3006.
# PORT=3006

# Atrás do proxy do alojamento, para ler o protocolo (https) certo.
TRUST_PROXY=1
